{
  "openapi": "3.1.0",
  "info": {
    "title": "Secure Genomic Variant Search API",
    "description": "Synthetic metric auditing demonstration (not Path ORAM, clinical validation, or regulatory compliance)",
    "version": "3.0.1-DEMO",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service health (authentication is enforced on other routes)"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON operational counters",
        "responses": {
          "200": {
            "description": "JSON counts (not Prometheus exposition text)"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "503": {
            "description": "API authentication not configured"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate synthetic metric audit rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "503": {
            "description": "API authentication not configured"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return a deterministic mock demonstration response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "503": {
            "description": "API authentication not configured"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "503": {
            "description": "API authentication not configured"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
